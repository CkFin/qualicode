# =====================================================================
#  Plantilla de configuracion. Copiar a .env y reemplazar valores.
#  En el servidor se genera automaticamente con:
#      sudo bash infra/server/generar_env.sh
#  .env NUNCA se versiona (ver .gitignore) y debe tener permisos 600.
#  Usar solo caracteres alfanumericos en las contrasenas.
# =====================================================================
DEPLOY_ENV=local
HTTP_PORT=80

# --- Base de datos ---
POSTGRES_DB=qualicode
POSTGRES_USER=qualicode_owner
POSTGRES_PASSWORD=CAMBIAR_valor_aleatorio
# Usuario de la aplicacion con privilegios minimos (sin DDL, auditoria solo INSERT)
APP_DB_USER=qualicode_app
APP_DB_PASSWORD=CAMBIAR_valor_aleatorio

# --- Sesiones (JWT en cookie HttpOnly) ---
JWT_SECRET=CAMBIAR_minimo_32_caracteres_aleatorios
JWT_TTL_MIN=30
# true solo si se publica con HTTPS
COOKIE_SECURE=false

# --- Administrador inicial (se crea al primer arranque) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_Admin2026

# --- Politicas ---
MAX_UPLOAD_BYTES=2097152
MAX_ACTIVE_JOBS_PER_USER=5
PROCESSING_DELAY_SECONDS=3
